  "instructions": {
    "shortText": "\u0627\u0641\u062A\u062D \u0648\u0627\u062C\u0647\u0629 \u0627\u0644\u062A\u062B\u0628\u064A\u062A\u060C \u062B\u0645 \u0627\u0636\u063A\u0637 \u062A\u062B\u0628\u064A\u062A \u062A\u0644\u0642\u0627\u0626\u064A \u0623\u0648 \u062D\u062F\u062F \u0645\u0633\u0627\u0631 Road 96.exe \u064A\u062F\u0648\u064A\u0627\u064B.",
    "detailedText": "\u062A\u0623\u0643\u062F \u0645\u0646 \u0625\u063A\u0644\u0627\u0642 \u0627\u0644\u0644\u0639\u0628\u0629 \u062A\u0645\u0627\u0645\u0627\u064B \u0642\u0628\u0644 \u0627\u0644\u0628\u062F\u0621. \u0634\u063A\u0651\u0644 \u0627\u0644\u0645\u062B\u0628\u062A \u0648\u0627\u0636\u063A\u0637 \u00AB\u062A\u062B\u0628\u064A\u062A \u062A\u0644\u0642\u0627\u0626\u064A\u00BB (\u0623\u0648 \u00AB\u062A\u062B\u0628\u064A\u062A \u064A\u062F\u0648\u064A\u00BB \u0648\u062D\u062F\u062F \u0645\u0633\u0627\u0631 \u062A\u0634\u063A\u064A\u0644 \u0627\u0644\u0644\u0639\u0628\u0629 \u0625\u0630\u0627 \u0644\u0632\u0645 \u0627\u0644\u0623\u0645\u0631). \u0628\u0639\u062F \u0627\u0643\u062A\u0645\u0627\u0644 \u0627\u0644\u062A\u062B\u0628\u064A\u062A\u060C \u0634\u063A\u0651\u0644 \u0627\u0644\u0644\u0639\u0628\u0629 \u0648\u0627\u062E\u062A\u0631 \u0627\u0644\u0644\u063A\u0629 \u0627\u0644\u0625\u064A\u0637\u0627\u0644\u064A\u0629 (Italian) \u0645\u0646 \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u062E\u064A\u0627\u0631\u0627\u062A (Options -\u003E Language)\u060C \u062B\u0645 \u0627\u062D\u0641\u0638 \u0648\u0627\u062E\u0631\u062C \u062A\u0645\u0627\u0645\u0627\u064B \u0645\u0646 \u0627\u0644\u0644\u0639\u0628\u0629 \u0648\u0623\u0639\u062F \u062A\u0634\u063A\u064A\u0644\u0647\u0627 \u0644\u062A\u0639\u0645\u0644 \u0628\u0627\u0644\u0644\u063A\u0629 \u0627\u0644\u0639\u0631\u0628\u064A\u0629. \u064A\u0645\u0643\u0646\u0643 \u0625\u0644\u063A\u0627\u0621 \u0627\u0644\u062A\u062B\u0628\u064A\u062A \u0648\u0627\u0644\u0627\u0633\u062A\u0639\u0627\u062F\u0629 \u0641\u064A \u0623\u064A \u0648\u0642\u062A \u0628\u0646\u0642\u0631\u0629 \u0648\u0627\u062D\u062F\u0629 \u0645\u0646 \u0627\u0644\u0648\u0627\u062C\u0647\u0629 \u0646\u0641\u0633\u0647\u0627.",
