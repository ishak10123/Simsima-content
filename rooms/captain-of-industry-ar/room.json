    "shortText": "\u0627\u0641\u062A\u062D \u0627\u0644\u0648\u0627\u062C\u0647\u0629 \u0645\u0646 Simsima \u062B\u0645 \u0627\u0633\u062A\u062E\u062F\u0645 \u0627\u0644\u062A\u062B\u0628\u064A\u062A \u0627\u0644\u062A\u0644\u0642\u0627\u0626\u064A\u060C \u0623\u0648 \u062D\u062F\u062F \u0645\u062C\u0644\u062F \u0627\u0644\u0644\u0639\u0628\u0629 \u064A\u062F\u0648\u064A\u0627 \u0639\u0646\u062F \u0627\u0644\u062D\u0627\u062C\u0629.",
    "detailedText": "\u062A\u0623\u0643\u062F \u0645\u0646 \u062A\u0648\u0627\u0641\u0642 \u0625\u0635\u062F\u0627\u0631 \u0627\u0644\u0644\u0639\u0628\u0629 \u0645\u0639 v0.8.8a \u0648\u0623\u063A\u0644\u0642\u0647\u0627 \u0642\u0628\u0644 \u0627\u0644\u062A\u062B\u0628\u064A\u062A. \u062C\u0631\u0651\u0628 \u0627\u0644\u062A\u062B\u0628\u064A\u062A \u0627\u0644\u062A\u0644\u0642\u0627\u0626\u064A \u0623\u0648\u0644\u064B\u0627. \u0625\u0630\u0627 \u0644\u0645 \u062A\u064F\u0643\u062A\u0634\u0641 \u0627\u0644\u0644\u0639\u0628\u0629\u060C \u0627\u062E\u062A\u0631 \u0645\u0644\u0641 \u062A\u0634\u063A\u064A\u0644 Captain of Industry \u0623\u0648 \u0645\u062C\u0644\u062F \u0627\u0644\u0644\u0639\u0628\u0629 \u0645\u0646 \u062E\u064A\u0627\u0631 \u0627\u0644\u0645\u0633\u0627\u0631 \u0627\u0644\u064A\u062F\u0648\u064A. \u0628\u0639\u062F \u0646\u062C\u0627\u062D \u0627\u0644\u062A\u062B\u0628\u064A\u062A \u0627\u062E\u062A\u0631 \u0627\u0644\u0644\u063A\u0629 \u0627\u0644\u062A\u0631\u0643\u064A\u0629 \u062F\u0627\u062E\u0644 \u0627\u0644\u0644\u0639\u0628\u0629. \u064A\u0645\u0643\u0646 \u0627\u0633\u062A\u0631\u062C\u0627\u0639 \u0627\u0644\u0645\u0644\u0641\u064A\u0646 \u0627\u0644\u0623\u0635\u0644\u064A\u064A\u0646 \u0645\u0646 \u0632\u0631 \u0625\u0644\u063A\u0627\u0621 \u0627\u0644\u062A\u062B\u0628\u064A\u062A.",
