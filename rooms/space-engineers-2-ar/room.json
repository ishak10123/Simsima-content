  "instructions": {
    "shortText": "\u0627\u0641\u062A\u062D \u0648\u0627\u062C\u0647\u0629 \u0627\u0644\u062A\u062B\u0628\u064A\u062A \u0645\u0646 Simsima\u060C \u062B\u0645 \u0627\u0636\u063A\u0637 \u0627\u0644\u062A\u062B\u0628\u064A\u062A \u0627\u0644\u062A\u0644\u0642\u0627\u0626\u064A \u0623\u0648 \u062D\u062F\u062F \u0645\u0633\u0627\u0631 SpaceEngineers2.exe \u064A\u062F\u0648\u064A\u0627\u064B.",
    "detailedText": "\u0628\u0639\u062F \u0641\u062A\u062D \u0648\u0627\u062C\u0647\u0629 \u0627\u0644\u062A\u062B\u0628\u064A\u062A\u060C \u062C\u0631\u0651\u0628 \u0627\u0644\u062A\u062B\u0628\u064A\u062A \u0627\u0644\u062A\u0644\u0642\u0627\u0626\u064A \u0623\u0648\u0644\u0627\u064B. \u0625\u0630\u0627 \u0644\u0645 \u064A\u062A\u0645 \u0627\u0644\u0639\u062B\u0648\u0631 \u0639\u0644\u0649 \u0627\u0644\u0644\u0639\u0628\u0629\u060C \u0627\u0636\u063A\u0637 \u0645\u0633\u0627\u0631 \u064A\u062F\u0648\u064A \u0648\u0627\u062E\u062A\u0631 \u0645\u0644\u0641 SpaceEngineers2.exe \u0645\u0646 \u062F\u0627\u062E\u0644 \u0645\u062C\u0644\u062F \u0627\u0644\u0644\u0639\u0628\u0629 (\u0623\u0648 \u0645\u062C\u0644\u062F Game2). \u0628\u0639\u062F \u0646\u062C\u0627\u062D \u0627\u0644\u062A\u062B\u0628\u064A\u062A\u060C \u0634\u063A\u0651\u0644 \u0627\u0644\u0644\u0639\u0628\u0629 \u0648\u062A\u0623\u0643\u062F \u0645\u0646 \u0627\u062E\u062A\u064A\u0627\u0631 \u0627\u0644\u0644\u063A\u0629 \u0627\u0644\u0625\u0646\u062C\u0644\u064A\u0632\u064A\u0629 (English) \u0645\u0646 \u0627\u0644\u0625\u0639\u062F\u0627\u062F\u0627\u062A. \u064A\u0645\u0643\u0646 \u0625\u0644\u063A\u0627\u0621 \u0627\u0644\u062A\u062B\u0628\u064A\u062A \u0648\u0627\u0633\u062A\u0639\u0627\u062F\u0629 \u0627\u0644\u0645\u0644\u0641\u0627\u062A \u0627\u0644\u0623\u0635\u0644\u064A\u0629 \u0644\u0627\u062D\u0642\u0627\u064B \u0628\u0636\u063A\u0637\u0629 \u0632\u0631. (\u0645\u0644\u0627\u062D\u0638\u0629: \u0647\u0630\u0647 \u0627\u0644\u0646\u0633\u062E\u0629 \u0645\u0627 \u0632\u0627\u0644\u062A \u0642\u064A\u062F \u0627\u0644\u062A\u0637\u0648\u064A\u0631\u060C \u0641\u064A \u062D\u0627\u0644 \u0648\u0627\u062C\u0647\u062A \u0623\u064A \u0623\u062E\u0637\u0627\u0621 \u0623\u0648 \u0645\u0644\u0627\u062D\u0638\u0627\u062A \u0646\u0631\u062C\u0648 \u0625\u0628\u0644\u0627\u063A\u0646\u0627 \u0628\u0647\u0627 \u0644\u0645\u062A\u0627\u0628\u0639\u062A\u0647\u0627 \u0648\u062A\u0635\u062D\u064A\u062D\u0647\u0627).",
