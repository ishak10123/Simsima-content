  "instructions": {
    "shortText": "\u0627\u0641\u062A\u062D \u0645\u062B\u0628\u062A Simsima\u060C \u062B\u0645 \u0627\u0636\u063A\u0637 \u062A\u062B\u0628\u064A\u062A \u062A\u0644\u0642\u0627\u0626\u064A \u0623\u0648 \u062D\u062F\u062F \u0645\u0633\u0627\u0631 Frostpunk.exe \u064A\u062F\u0648\u064A\u0627\u064B.",
    "detailedText": "\u0628\u0639\u062F \u062A\u0634\u063A\u064A\u0644 \u0627\u0644\u0648\u0627\u062C\u0647\u0629\u060C \u0627\u0636\u063A\u0637 \u0632\u0631 \u0027\u062A\u062B\u0628\u064A\u062A \u062A\u0644\u0642\u0627\u0626\u064A\u0027 \u0644\u0627\u0643\u062A\u0634\u0627\u0641 \u0627\u0644\u0644\u0639\u0628\u0629 \u0648\u062D\u0642\u0646 \u0627\u0644\u062E\u0637\u0648\u0637 \u0648\u0627\u0644\u062A\u0631\u062C\u0645\u0629 \u0641\u064A \u062B\u0648\u0627\u0646\u064D \u0645\u0639\u062F\u0648\u062F\u0629. \u0625\u0630\u0627 \u0644\u0645 \u064A\u062A\u0645 \u0627\u0643\u062A\u0634\u0627\u0641 \u0627\u0644\u0645\u0633\u0627\u0631 \u062A\u0644\u0642\u0627\u0626\u064A\u0627\u064B\u060C \u0627\u0636\u063A\u0637 \u0027\u0645\u0633\u0627\u0631 \u064A\u062F\u0648\u064A\u0027 \u0648\u0627\u062E\u062A\u0631 \u0645\u0644\u0641 Frostpunk.exe. \u0628\u0639\u062F \u0627\u0643\u062A\u0645\u0627\u0644 \u0627\u0644\u062A\u062B\u0628\u064A\u062A\u060C \u0627\u0641\u062A\u062D \u0627\u0644\u0644\u0639\u0628\u0629 \u0648\u0633\u062A\u062C\u062F \u0627\u0644\u0644\u063A\u0629 \u0627\u0644\u0639\u0631\u0628\u064A\u0629 \u0645\u0641\u0639\u0644\u0629 \u0645\u0628\u0627\u0634\u0631\u0629. \u064A\u0645\u0643\u0646\u0643 \u0627\u0633\u062A\u0631\u062C\u0627\u0639 \u0627\u0644\u0645\u0644\u0641\u0627\u062A \u0627\u0644\u0623\u0635\u0644\u064A\u0629 \u0628\u0627\u0644\u0643\u0627\u0645\u0644 \u0641\u064A \u0623\u064A \u0648\u0642\u062A \u0628\u0627\u0644\u0636\u063A\u0637 \u0639\u0644\u0649 \u0632\u0631 \u0027\u0625\u0644\u063A\u0627\u0621 \u0627\u0644\u062A\u062B\u0628\u064A\u062A\u0027.",
