  "summary": "\u062A\u0639\u0631\u064A\u0628 \u0639\u0631\u0628\u064A \u0644\u0644\u0639\u0628\u0629 Palworld \u064A\u062B\u0628\u062A \u0645\u0644\u0641 \u0627\u0644\u0645\u0648\u062F \u062F\u0627\u062E\u0644 \u0645\u062C\u0644\u062F Paks \u0648\u064A\u0639\u0645\u0644 \u0639\u0628\u0631 \u0648\u0627\u062C\u0647\u0629 \u062A\u062B\u0628\u064A\u062A \u062F\u0627\u062E\u0644\u064A\u0629.",
  "description": "\u062D\u0632\u0645\u0629 \u062A\u0639\u0631\u064A\u0628 \u0639\u0631\u0628\u064A\u0629 \u0644\u0644\u0639\u0628\u0629 Palworld. \u064A\u062A\u064A\u062D \u0628\u0631\u0646\u0627\u0645\u062C Simsima \u062A\u0646\u0632\u064A\u0644 \u0627\u0644\u062D\u0632\u0645\u0629 \u0648\u0641\u062A\u062D \u0648\u0627\u062C\u0647\u0629 \u062A\u062B\u0628\u064A\u062A \u062F\u0627\u062E\u0644\u064A\u0629 \u0644\u0644\u062A\u062B\u0628\u064A\u062A \u0627\u0644\u062A\u0644\u0642\u0627\u0626\u064A \u0623\u0648 \u0627\u062E\u062A\u064A\u0627\u0631 \u0645\u0633\u0627\u0631 \u0627\u0644\u0644\u0639\u0628\u0629 \u064A\u062F\u0648\u064A\u0627\u060C \u0645\u0639 \u0625\u0645\u0643\u0627\u0646\u064A\u0629 \u0625\u0644\u063A\u0627\u0621 \u0627\u0644\u062A\u062B\u0628\u064A\u062A \u0644\u0627\u062D\u0642\u0627. \u0628\u0639\u062F \u0627\u0644\u062A\u062B\u0628\u064A\u062A \u0627\u062E\u062A\u0631 \u0627\u0644\u0644\u063A\u0629 \u0627\u0644\u062A\u0631\u0643\u064A\u0629 \u0645\u0646 \u0625\u0639\u062F\u0627\u062F\u0627\u062A \u0627\u0644\u0644\u0639\u0628\u0629 \u062D\u062A\u0649 \u062A\u0638\u0647\u0631 \u0627\u0644\u0646\u0635\u0648\u0635 \u0627\u0644\u0639\u0631\u0628\u064A\u0629.",
