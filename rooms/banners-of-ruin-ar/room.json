  "instructions": {
    "shortText": "\u062A\u0623\u0643\u062F \u0645\u0646 \u0623\u0646 \u0627\u0644\u0644\u0639\u0628\u0629 \u0628\u0646\u0633\u062E\u0629 Steam 1.4.67 \u0648\u0623\u063A\u0644\u0642\u0647\u0627\u060C \u062B\u0645 \u0627\u0636\u063A\u0637 \u062A\u0646\u0632\u064A\u0644 \u0648\u0641\u062A\u062D \u0648\u0627\u062C\u0647\u0629 \u0627\u0644\u062A\u062B\u0628\u064A\u062A\u060C \u0648\u062B\u0628\u0651\u062A \u0627\u0644\u062A\u0639\u0631\u064A\u0628 \u0648\u0627\u062E\u062A\u0631 \u0627\u0644\u0639\u0631\u0628\u064A\u0629 \u0645\u0646 \u0625\u0639\u062F\u0627\u062F\u0627\u062A \u0627\u0644\u0644\u0639\u0628\u0629.",
    "detailedText": "\u0627\u0644\u062D\u0632\u0645\u0629 \u0645\u062E\u0635\u0635\u0629 \u0644\u0646\u0633\u062E\u0629 Steam 1.4.67 \u0648\u062A\u0634\u0645\u0644 \u062A\u0631\u062C\u0645\u0627\u062A \u0627\u0644\u0644\u0639\u0628\u0629 \u0627\u0644\u0623\u0633\u0627\u0633\u064A\u0629 \u0648\u0625\u0636\u0627\u0641\u0627\u062A Bard \u0648Powdermaster \u0648Rogue \u0627\u0644\u0645\u0648\u062C\u0648\u062F\u0629 \u0644\u062F\u064A\u0643. \u0623\u063A\u0644\u0642 \u0627\u0644\u0644\u0639\u0628\u0629 \u0648\u0627\u0636\u063A\u0637 \u062A\u0646\u0632\u064A\u0644 \u0648\u0641\u062A\u062D \u0648\u0627\u062C\u0647\u0629 \u0627\u0644\u062A\u062B\u0628\u064A\u062A\u060C \u062B\u0645 \u062C\u0631\u0651\u0628 \u0627\u0644\u062A\u062B\u0628\u064A\u062A \u0627\u0644\u062A\u0644\u0642\u0627\u0626\u064A. \u0644\u0644\u0645\u0633\u0627\u0631 \u0627\u0644\u064A\u062F\u0648\u064A \u0627\u062E\u062A\u0631 BannersOfRuin.exe \u0623\u0648 Banners of Ruin.exe \u062F\u0627\u062E\u0644 \u062C\u0630\u0631 \u0627\u0644\u0644\u0639\u0628\u0629. \u0625\u0630\u0627 \u0643\u0627\u0646 \u0627\u0644\u062A\u0639\u0631\u064A\u0628 \u0627\u0644\u0642\u062F\u064A\u0645 0.1.6 \u0645\u062B\u0628\u062A\u0627\u064B \u062E\u0627\u0631\u062C \u0647\u0630\u0627 \u0627\u0644\u0646\u0638\u0627\u0645\u060C \u0627\u0633\u062A\u0631\u062C\u0639 \u0645\u0644\u0641\u0627\u062A \u0627\u0644\u0644\u0639\u0628\u0629 \u0627\u0644\u0623\u0635\u0644\u064A\u0629 \u0623\u0648\u0644\u0627\u064B \u0628\u0648\u0627\u0633\u0637\u0629 \u0646\u0633\u062E\u062A\u0647 \u0627\u0644\u0627\u062D\u062A\u064A\u0627\u0637\u064A\u0629 \u0623\u0648 \u0627\u0644\u062A\u062D\u0642\u0642 \u0645\u0646 \u0645\u0644\u0641\u0627\u062A \u0627\u0644\u0644\u0639\u0628\u0629. \u0627\u062E\u062A\u0631 \u0627\u0644\u0639\u0631\u0628\u064A\u0629 \u0645\u0646 \u0627\u0644\u0625\u0639\u062F\u0627\u062F\u0627\u062A \u0628\u0639\u062F \u0646\u062C\u0627\u062D \u0627\u0644\u062A\u062B\u0628\u064A\u062A. \u064A\u0645\u0643\u0646 \u0625\u0644\u063A\u0627\u0621