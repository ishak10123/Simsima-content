  "instructions": {
    "shortText": "\u0646\u0633\u062E\u0629 \u0623\u0648\u0644\u064A\u0629 \u0644\u0644\u0639\u0628\u0629 \u0627\u0644\u0623\u0633\u0627\u0633\u064A\u0629 \u0641\u0642\u0637 \u0628\u062F\u0648\u0646 DLC. \u0627\u0636\u063A\u0637 \u062A\u062B\u0628\u064A\u062A \u062A\u0644\u0642\u0627\u0626\u064A \u0644\u0646\u0642\u0644 \u0627\u0644\u0645\u0648\u062F \u0648\u0645\u0633\u062D \u0627\u0644\u0643\u0627\u0634.",
    "detailedText": "\u26A0\uFE0F \u062A\u0646\u0628\u064A\u0647 \u0647\u0627\u0645: \u0647\u0630\u0627 \u0627\u0644\u062A\u0639\u0631\u064A\u0628 \u0647\u0648 \u0625\u0635\u062F\u0627\u0631 \u0623\u0648\u0644\u064A (v0.1.0) \u0645\u062E\u0635\u0635 \u0644\u0644\u0639\u0628\u0629 \u0627\u0644\u0623\u0633\u0627\u0633\u064A\u0629 \u0641\u0642\u0637 (Base Game) \u0628\u062F\u0648\u0646 \u0623\u064A \u0625\u0636\u0627\u0641\u0627\u062A (DLCs) \u0648\u0647\u0648 \u0642\u064A\u062F \u0627\u0644\u062A\u0637\u0648\u064A\u0631 \u0627\u0644\u0646\u0634\u0637 \u0644\u0644\u062A\u062D\u062F\u064A\u062B\u0627\u062A \u0627\u0644\u0642\u0627\u062F\u0645\u0629.\n\u0628\u0639\u062F \u0641\u062A\u062D \u0648\u0627\u062C\u0647\u0629 \u0627\u0644\u062A\u062B\u0628\u064A\u062A\u060C \u0627\u0636\u063A\u0637 \u0639\u0644\u0649 \u0027\u062A\u062B\u0628\u064A\u062A \u062A\u0644\u0642\u0627\u0626\u064A\u0027 \u0644\u0646\u0642\u0644 \u062D\u0632\u0645 \u0627\u0644\u062A\u0639\u0631\u064A\u0628 \u0625\u0644\u0649 \u0645\u062C\u0644\u062F Mods \u0648\u062A\u0646\u0638\u064A\u0641 \u0630\u0627\u0643\u0631\u0629 \u0627\u0644\u062A\u062E\u0632\u064A\u0646 \u0627\u0644\u0645\u0624\u0642\u062A (localthumbcache.package) \u0644\u0644\u0639\u0628\u0629. \u0625\u0630\u0627 \u0644\u0645 \u064A\u062A\u0645 \u0627\u0644\u0639\u062B\u0648\u0631 \u0639\u0644\u0649 \u0627\u0644\u0645\u0633\u0627\u0631\u060C \u0627\u0636\u063A\u0637 \u0645\u0633\u0627\u0631 \u064A\u062F\u0648\u064A \u0648\u0627\u062E\u062A\u0631 TS4_x64.exe \u0623\u0648 \u0645\u062C\u0644\u062F The Sims 4. \u0628\u0639\u062F \u0627\u0644\u062A\u062B\u0628\u064A\u062A\u060C \u0627\u0641\u062A\u062D \u0627\u0644\u0644\u0639\u0628\u0629 \u0648\u062A\u0623\u0643\u062F \u0645\u0646 \u062A\u0641\u0639\u064A\u0644 \u062E\u064A\u0627\u0631 Enable Custom Content and Mods \u0645\u0646 Game Options \u003E Other \u062B\u0645 \u0623\u0639\u062F \u062A\u0634\u063A\u064A\u0644 \u0627\u0644\u0644\u0639\u0628\u0629.",
