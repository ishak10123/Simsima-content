  "instructions": {
    "shortText": "\u0627\u0641\u062A\u062D \u0648\u0627\u062C\u0647\u0629 \u0627\u0644\u062A\u062B\u0628\u064A\u062A \u0645\u0646 Simsima\u060C \u062B\u0645 \u0627\u0636\u063A\u0637 \u062A\u062B\u0628\u064A\u062A \u062A\u0644\u0642\u0627\u0626\u064A \u0623\u0648 \u062D\u062F\u062F \u0645\u0633\u0627\u0631 \u0627\u0644\u0644\u0639\u0628\u0629 \u064A\u062F\u0648\u064A\u0627\u064B.",
    "detailedText": "\u0628\u0639\u062F \u0641\u062A\u062D \u0648\u0627\u062C\u0647\u0629 \u0627\u0644\u062A\u062B\u0628\u064A\u062A\u060C \u062C\u0631\u0651\u0628 \u0627\u0644\u062A\u062B\u0628\u064A\u062A \u0627\u0644\u062A\u0644\u0642\u0627\u0626\u064A \u0623\u0648\u0644\u0627\u064B \u0644\u0627\u0643\u062A\u0634\u0627\u0641 \u0627\u0644\u0644\u0639\u0628\u0629 \u0639\u0644\u0649 Steam. \u0625\u0630\u0627 \u0644\u0645 \u064A\u062A\u0645 \u0627\u0644\u0639\u062B\u0648\u0631 \u0639\u0644\u064A\u0647\u0627\u060C \u0627\u0636\u063A\u0637 \u0645\u0633\u0627\u0631 \u064A\u062F\u0648\u064A \u0648\u0627\u062E\u062A\u0631 \u0645\u0644\u0641 spacehaven.exe \u0623\u0648 spacehaven.jar \u0645\u0646 \u0645\u062C\u0644\u062F \u0627\u0644\u0644\u0639\u0628\u0629. \u0628\u0639\u062F \u0627\u0643\u062A\u0645\u0627\u0644 \u0627\u0644\u062A\u062B\u0628\u064A\u062A\u060C \u0627\u0641\u062A\u062D \u0627\u0644\u0644\u0639\u0628\u0629 \u0648\u0627\u062E\u062A\u0631 \u0627\u0644\u0639\u0631\u0628\u064A\u0629 (Arabic) \u0645\u0646 \u0625\u0639\u062F\u0627\u062F\u0627\u062A \u0627\u0644\u0644\u063A\u0629. \u064A\u0645\u0643\u0646\u0643 \u0625\u0644\u063A\u0627\u0621 \u0627\u0644\u062A\u062B\u0628\u064A\u062A \u0644\u0627\u062D\u0642\u0627\u064B \u0628\u0646\u0642\u0631\u0629 \u0648\u0627\u062D\u062F\u0629 \u0645\u0646 \u0646\u0641\u0633 \u0627\u0644\u0648\u0627\u062C\u0647\u0629.",
