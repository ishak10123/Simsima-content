  "instructions": {
    "shortText": "\u0623\u063A\u0644\u0642 \u0627\u0644\u0644\u0639\u0628\u0629 \u0642\u0628\u0644 \u0627\u0644\u062A\u062B\u0628\u064A\u062A. \u0627\u0641\u062A\u062D \u0627\u0644\u0645\u062B\u0628\u0651\u062A \u0645\u0646 Simsima\u060C \u062B\u0645 \u0627\u062E\u062A\u0631 \u0627\u0644\u062A\u062B\u0628\u064A\u062A \u0627\u0644\u062A\u0644\u0642\u0627\u0626\u064A. \u0628\u0639\u062F \u0627\u0644\u062A\u062B\u0628\u064A\u062A \u0627\u062E\u062A\u0631 \u0627\u0644\u0644\u063A\u0629 \u0627\u0644\u062A\u0631\u0643\u064A\u0629 \u062F\u0627\u062E\u0644 \u0627\u0644\u0644\u0639\u0628\u0629.",
    "detailedText": "\u0647\u0630\u0627 \u0627\u0644\u062A\u0639\u0631\u064A\u0628 \u0645\u062E\u0635\u0651\u0635 \u0644\u0625\u0635\u062F\u0627\u0631 \u0627\u0644\u0644\u0639\u0628\u0629 v0.8.8d. \u0623\u063A\u0644\u0642 \u0627\u0644\u0644\u0639\u0628\u0629 \u0648\u0627\u0641\u062A\u062D \u0627\u0644\u0645\u062B\u0628\u0651\u062A \u0645\u0646 Simsima. \u0625\u0630\u0627 \u0644\u0645 \u064A\u0639\u062B\u0631 \u0627\u0644\u0645\u062B\u0628\u0651\u062A \u0639\u0644\u0649 \u0627\u0644\u0644\u0639\u0628\u0629\u060C \u0627\u0636\u063A\u0637 \u00AB\u0645\u0633\u0627\u0631 \u064A\u062F\u0648\u064A\u00BB \u0648\u062D\u062F\u0651\u062F \u0645\u0644\u0641 \u062A\u0634\u063A\u064A\u0644 \u0627\u0644\u0644\u0639\u0628\u0629 \u0623\u0648 \u0645\u062C\u0644\u062F\u0647\u0627. \u0628\u0639\u062F \u0627\u0644\u062A\u062B\u0628\u064A\u062A \u0627\u062E\u062A\u0631 \u0627\u0644\u0644\u063A\u0629 \u0627\u0644\u062A\u0631\u0643\u064A\u0629 \u0645\u0646 \u0625\u0639\u062F\u0627\u062F\u0627\u062A \u0627\u0644\u0644\u0639\u0628\u0629. \u0644\u0627\u0633\u062A\u0639\u0627\u062F\u0629 \u0645\u0644\u0641\u0627\u062A \u0627\u0644\u0644\u0639\u0628\u0629 \u0627\u0644\u0623\u0635\u0644\u064A\u0629\u060C \u0627\u0641\u062A\u062D \u0627\u0644\u0645\u062B\u0628\u0651\u062A \u0648\u0627\u0636\u063A\u0637 \u00AB\u0625\u0644\u063A\u0627\u0621 \u0627\u0644\u062A\u062B\u0628\u064A\u062A\u00BB.",
