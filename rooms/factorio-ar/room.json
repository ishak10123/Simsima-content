  "summary": "\u062A\u0639\u0631\u064A\u0628 \u0639\u0631\u0628\u064A \u0644\u0644\u0639\u0628\u0629 Factorio \u0648\u0645\u062D\u062A\u0648\u0649 Space Age \u0628\u062D\u0633\u0628 \u0645\u0644\u0641\u0627\u062A \u0627\u0644\u062D\u0632\u0645\u0629 \u0627\u0644\u0645\u0631\u0641\u0642\u0629.",
  "description": "\u0645\u0644\u0641\u0627\u062A \u062A\u0631\u062C\u0645\u0629 \u0639\u0631\u0628\u064A\u0629 \u0644\u0644\u0639\u0628\u0629 \u0627\u0644\u0623\u0633\u0627\u0633\u064A\u0629 \u0648\u0627\u0644\u062D\u0645\u0644\u0627\u062A \u0648\u0627\u0644\u0633\u064A\u0646\u0627\u0631\u064A\u0648\u0647\u0627\u062A \u0648\u0627\u0644\u062F\u0631\u0648\u0633 \u0627\u0644\u062A\u0639\u0644\u064A\u0645\u064A\u0629\u060C \u0645\u0639 \u0645\u0644\u0641\u0627\u062A Space Age \u0648Quality \u0648Elevated Rails \u0639\u0646\u062F \u062A\u0648\u0641\u0631 \u0647\u0630\u0647 \u0627\u0644\u0625\u0636\u0627\u0641\u0627\u062A. \u062A\u0636\u0645 \u0627\u0644\u062D\u0632\u0645\u0629 \u0648\u0627\u062C\u0647\u0629 \u0644\u0644\u062A\u062B\u0628\u064A\u062A \u0627\u0644\u062A\u0644\u0642\u0627\u0626\u064A \u0648\u0627\u062E\u062A\u064A\u0627\u0631 \u0627\u0644\u0645\u0633\u0627\u0631 \u064A\u062F\u0648\u064A\u064B\u0627 \u0648\u0627\u0633\u062A\u0631\u062C\u0627\u0639 \u0627\u0644\u0645\u0644\u0641\u0627\u062A \u0627\u0644\u0623\u0635\u0644\u064A\u0629.",
