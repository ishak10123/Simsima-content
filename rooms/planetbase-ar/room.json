  "instructions": {
    "shortText": "\u062A\u0623\u0643\u062F \u0645\u0646 \u0625\u063A\u0644\u0627\u0642 \u0644\u0639\u0628\u0629 Planetbase\u060C \u062B\u0645 \u0627\u0641\u062A\u062D \u0648\u0627\u062C\u0647\u0629 \u0627\u0644\u062A\u062B\u0628\u064A\u062A \u0648\u0627\u0636\u063A\u0637 \u0639\u0644\u0649 \u062A\u062B\u0628\u064A\u062A \u062A\u0644\u0642\u0627\u0626\u064A\u060C \u062B\u0645 \u0627\u062E\u062A\u0631 \u0627\u0644\u0644\u063A\u0629 \u0627\u0644\u0639\u0631\u0628\u064A\u0629 \u0645\u0646 \u0625\u0639\u062F\u0627\u062F\u0627\u062A \u0627\u0644\u0644\u0639\u0628\u0629.",
    "detailedText": "\u062A\u0623\u0643\u062F \u0645\u0646 \u062A\u0648\u0627\u0641\u0642 \u0627\u0644\u0644\u0639\u0628\u0629 \u0645\u0639 \u0627\u0644\u0625\u0635\u062F\u0627\u0631 1.4.2 \u0648\u0623\u063A\u0644\u0642\u0647\u0627 \u062A\u0645\u0627\u0645\u0627\u064B \u0642\u0628\u0644 \u0627\u0644\u0628\u062F\u0621. \u0628\u0639\u062F \u0641\u062A\u062D \u0648\u0627\u062C\u0647\u0629 \u0627\u0644\u062A\u062B\u0628\u064A\u062A\u060C \u0627\u0636\u063A\u0637 \u0639\u0644\u0649 \u00AB\u062A\u062B\u0628\u064A\u062A \u062A\u0644\u0642\u0627\u0626\u064A\u00BB \u0644\u064A\u062A\u0645 \u0627\u0643\u062A\u0634\u0627\u0641 \u0645\u0633\u0627\u0631 \u0627\u0644\u0644\u0639\u0628\u0629 \u0648\u062D\u0642\u0646 \u0627\u0644\u062A\u0639\u0631\u064A\u0628 \u0648\u0625\u0646\u0634\u0627\u0621 \u0646\u0633\u062E\u0629 \u0627\u062D\u062A\u064A\u0627\u0637\u064A\u0629 \u062A\u0644\u0642\u0627\u0626\u064A\u0627\u064B. \u0625\u0630\u0627 \u0643\u0627\u0646\u062A \u0627\u0644\u0644\u0639\u0628\u0629 \u0641\u064A \u0645\u0633\u0627\u0631 \u0645\u062E\u0635\u0635\u060C \u0627\u0633\u062A\u062E\u062F\u0645 \u0632\u0631 \u00AB\u0645\u0633\u0627\u0631 \u064A\u062F\u0648\u064A\u00BB \u0648\u062D\u062F\u062F \u0645\u0644\u0641 Planetbase.exe. \u0628\u0639\u062F \u0627\u0643\u062A\u0645\u0627\u0644 \u0627\u0644\u062A\u062B\u0628\u064A\u062A \u0628\u0646\u062C\u0627\u062D\u060C \u0634\u063A\u0651\u0644 \u0627\u0644\u0644\u0639\u0628\u0629 \u0648\u062A\u0648\u062C\u0647 \u0625\u0644\u0649 \u0627\u0644\u0625\u0639\u062F\u0627\u062F\u0627\u062A Settings \u062B\u0645 \u0627\u062E\u062A\u0631 \u0627\u0644\u0639\u0631\u0628\u064A\u0629 \u0645\u0646 \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0644\u063A\u0627\u062A. \u064A\u0645\u0643\u0646\u0643 \u0627\u0633\u062A\u0639\u0627\u062F\u0629 \u0645\u0644\u0641\u0627\u062A \u0627\u0644\u0644\u0639\u0628\u0629 \u0627\u0644\u0623\u0635\u0644\u064A\u0629 \u0641\u064A \u0623\u064A \u0648\u0642\u062A \u0628\u0627\u0644\u0636\u063A\u0637 \u0639\u0644\u0649 \u00AB\u0625\u0644\u063A\u0627\u0621 \u0627\u0644\u062A\u062B\u0628\u064A\u062A / \u0627\u0633\u062A\u0631\u062C\u0627\u0639\u00BB \u0645\u0646 \u0648\u0627\u062C\u0647\u0629 \u0627\u0644\u0645\u062B\u0628\u062A \u0646\u0641\u0633\u0647\u0627.",
